# 설정 항목 안내용. 서버는 .env 파일을 자동으로 읽지 않는다.
# 실제 값은 실행하는 Node.js 프로세스의 환경변수로 전달한다.

# 학교명은 AI가 대화·작업 설정에서 확인해 도구 인수로 전달한다.
# 학교 식별·계획 원문 조회에는 학교알리미 API 키가 필요하지 않다.

# NEIS: 학사일정에 필요
# 발급 안내: https://open.neis.go.kr
NEIS_API_KEY=

# 아래 항목은 HTTP 실행(npm start)에만 사용
HOST=127.0.0.1
PORT=8080

# HOST=0.0.0.0 등 외부 바인딩 시 필수
# 클라이언트 요청: Authorization: Bearer <이 값>
SCHOOLINFO_MCP_TOKEN=

# Origin 헤더가 있는 요청에 허용할 출처. 여러 개는 쉼표로 구분
# 기본 빈 목록은 모든 브라우저 Origin을 거부
SCHOOLINFO_MCP_ALLOWED_ORIGINS=
