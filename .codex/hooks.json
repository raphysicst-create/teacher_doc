{
  "description": "teacher_doc adapters. Host trust and integration verification required.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Users/USER/AppData/Local/Programs/Python/Python312/python.exe' -X utf8 'C:/Users/USER/Desktop/maintain/teacher_doc/.claude/hooks/protect_files.py'; exit $LASTEXITCODE\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write|mcp__kordoc__.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Users/USER/AppData/Local/Programs/Python/Python312/python.exe' -X utf8 'C:/Users/USER/Desktop/maintain/teacher_doc/.claude/hooks/stop_validator.py'; exit $LASTEXITCODE\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Users/USER/AppData/Local/Programs/Python/Python312/python.exe' -X utf8 'C:/Users/USER/Desktop/maintain/teacher_doc/.claude/hooks/audit_log.py'; exit $LASTEXITCODE\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write|mcp__kordoc__.*"
      }
    ]
  }
}
